# SaveIt web — copy to .env.local and fill in.
#
# Only NEXT_PUBLIC_* values reach the browser. Both of these are safe to expose:
# the anon key is a public key whose every request is filtered by row-level
# security (migrations 0002). The service-role key must NEVER appear here or in
# any file under apps/web — it bypasses RLS and belongs only to edge functions.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Where the web app calls the edge functions. Defaults to
# ${NEXT_PUBLIC_SUPABASE_URL}/functions/v1 — set it only if the functions live
# somewhere else (a local `supabase start`, for example).
# NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
